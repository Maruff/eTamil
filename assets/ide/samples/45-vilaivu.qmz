// சரி / தவறு — தோல்வியை மதிப்பாகவே திருப்பும் முறை.
செயல் பிரி_பாதுகாப்பாக(அ, ஆ) {
    (ஆ == 0) எனில் {
        திரும்பு தவறு("பூஜ்யத்தால் வகுக்க முடியாது");
    }
    திரும்பு சரி(அ / ஆ);
}

விடை1 = பிரி_பாதுகாப்பாக(10, 2);
(சரியா(விடை1)) எனில் {
    அச்சு("விடை: " & மதிப்பு(விடை1));
}

விடை2 = பிரி_பாதுகாப்பாக(10, 0);
(தவறா(விடை2)) எனில் {
    அச்சு("பிழை: " & தவறு_மதிப்பு(விடை2));
}

அச்சு("இயல்பு மதிப்புடன்: " & இயல்பு(விடை2, 0));
