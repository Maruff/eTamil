பொருட்கள் = ["எழுதுகோல்", "நோட்டு", "கணிப்பான்"];
விலைகள் = [20, 60, 750];
எண்ணிக்கைகள் = [10, 5, 1];

மொத்தம் = 0;
இ = 0;

(இ < நீளம்(பொருட்கள்)) சுற்று {
    வரித்_தொகை = விலைகள்[இ] * எண்ணிக்கைகள்[இ];
    அச்சு(பொருட்கள்[இ] & " x " & எண்ணிக்கைகள்[இ] & " = " & வரித்_தொகை);
    மொத்தம் = மொத்தம் + வரித்_தொகை;
    இ = இ + 1;
}

வரி = வட்டமிடு(மொத்தம் * 18%, 2);
அச்சு("---");
அச்சு("கூட்டுத்தொகை: " & மொத்தம்);
அச்சு("வணிகவரி 18%: " & வரி);
அச்சு("செலுத்த வேண்டியது: " & (மொத்தம் + வரி));
