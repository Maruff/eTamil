எண்கள் = [5, 2, 9, 1, 7];
எ = நீளம்(எண்கள்);
இ = 0;

(இ < எ) சுற்று {
    ஜ = 0;
    (ஜ < எ - இ - 1) சுற்று {
        (எண்கள்[ஜ] > எண்கள்[ஜ + 1]) எனில் {
            தற்காலிகம் = எண்கள்[ஜ];
            எண்கள்[ஜ] = எண்கள்[ஜ + 1];
            எண்கள்[ஜ + 1] = தற்காலிகம்;
        }
        ஜ = ஜ + 1;
    }
    இ = இ + 1;
}

அச்சு(ஒன்றிணை(எண்கள், ", "));
