// இடம் / வலம் ஆகியவை மொழியின் சொற்கள், மாறிப் பெயர் அல்ல.
செயல் மறுபக்கமா(எழுத்துகள்) {
    இ = 0;
    ஜ = நீளம்(எழுத்துகள்) - 1;
    (இ < ஜ) சுற்று {
        (எழுத்துகள்[இ] != எழுத்துகள்[ஜ]) எனில் {
            திரும்பு பொய்;
        }
        இ = இ + 1;
        ஜ = ஜ - 1;
    }
    திரும்பு மெய்;
}

அச்சு(மறுபக்கமா(["m", "a", "l", "a", "y", "a", "l", "a", "m"]));
அச்சு(மறுபக்கமா(["t", "a", "m", "i", "l"]));
