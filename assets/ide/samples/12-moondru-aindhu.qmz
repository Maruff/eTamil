செயல் வகுபடுமா(எ, வ) {
    திரும்பு எ - (எ / வ) * வ == 0;
}

எண் இ = 1;
(இ <= 15) சுற்று {
    (வகுபடுமா(இ, 15)) எனில் {
        அச்சு("மூன்றைந்து");
    }
    இன்றேல் {
        (வகுபடுமா(இ, 3)) எனில் {
            அச்சு("மூன்று");
        }
        இன்றேல் {
            (வகுபடுமா(இ, 5)) எனில் {
                அச்சு("ஐந்து");
            }
            இன்றேல் {
                அச்சு(இ);
            }
        }
    }
    இ = இ + 1;
}
