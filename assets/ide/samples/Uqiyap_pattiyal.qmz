பணியாளர்கள் = ["அமுதா", "குமார்", "ரமேஷ்"];
அடிப்படை = [45000, 38000, 52000];

இ = 0;
மொத்த_ஊதியம் = 0;

(இ < நீளம்(பணியாளர்கள்)) சுற்று {
    அ = அடிப்படை[இ];
    அகவிலை = அ * 20%;
    வருங்காலம் = அ * 12%;
    நிகர = அ + அகவிலை - வருங்காலம்;

    அச்சு(பணியாளர்கள்[இ] & " -> நிகர " & வட்டமிடு(நிகர, 2));
    மொத்த_ஊதியம் = மொத்த_ஊதியம் + நிகர;
    இ = இ + 1;
}

அச்சு("---");
அச்சு("மொத்த ஊதியம்: " & வட்டமிடு(மொத்த_ஊதியம், 2));
