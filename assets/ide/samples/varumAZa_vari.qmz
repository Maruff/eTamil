// படிநிலை வாரியாக — ஒவ்வொரு அடுக்கும் தனித்தனியே.
செயல் வரி_கணக்கு(வருவாய்) {
    வரி = 0;
    (வருவாய் > 1500000) எனில் {
        வரி = வரி + (வருவாய் - 1500000) * 30%;
        வருவாய் = 1500000;
    }
    (வருவாய் > 1200000) எனில் {
        வரி = வரி + (வருவாய் - 1200000) * 20%;
        வருவாய் = 1200000;
    }
    (வருவாய் > 900000) எனில் {
        வரி = வரி + (வருவாய் - 900000) * 15%;
        வருவாய் = 900000;
    }
    (வருவாய் > 600000) எனில் {
        வரி = வரி + (வருவாய் - 600000) * 10%;
        வருவாய் = 600000;
    }
    (வருவாய் > 300000) எனில் {
        வரி = வரி + (வருவாய் - 300000) * 5%;
    }
    திரும்பு வட்டமிடு(வரி, 2);
}

ஒவ்வொரு வ இல் [450000, 850000, 1400000, 2000000] {
    அச்சு("வருவாய் " & வ & " -> வரி " & வரி_கணக்கு(வ));
}
