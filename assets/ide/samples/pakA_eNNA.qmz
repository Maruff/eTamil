செயல் பகாஎண்ணா(எ) {
    (எ < 2) எனில் {
        திரும்பு பொய்;
    }
    வ = 2;
    (வ * வ <= எ) சுற்று {
        (எ - (எ / வ) * வ == 0) எனில் {
            திரும்பு பொய்;
        }
        வ = வ + 1;
    }
    திரும்பு மெய்;
}

ஒவ்வொரு எ இல் [7, 12, 29, 33] {
    அச்சு(எ & " பகா எண்ணா? " & பகாஎண்ணா(எ));
}
